# Hira — Variables de entorno
# Copiar a .env y completar los valores antes de levantar los servicios

# ── Modo de despliegue ──────────────────────────────────────────────────────
# server → PostgreSQL + TimescaleDB (producción / campo)
# studio → SQLite (modo offline, PC del integrador)
HIRA_DEPLOY_MODE=server

# ── Base de datos (PostgreSQL) ──────────────────────────────────────────────
POSTGRES_DB=hira
POSTGRES_USER=hira
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://hira:${POSTGRES_PASSWORD}@postgres:5432/hira

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ── Seguridad ───────────────────────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
LICENSE_KEY=

# ── CORS ────────────────────────────────────────────────────────────────────
# Lista de orígenes permitidos separados por coma
# Ejemplo: http://localhost:5173,https://hira.ejemplo.com
CORS_ORIGINS=http://localhost:5173

# ── MQTT / Mosquitto ────────────────────────────────────────────────────────
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_USER=
MQTT_PASSWORD=

# ── Cifrado AI ──────────────────────────────────────────────────────────────
# Clave Fernet de 32 bytes en base64
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_ENCRYPTION_KEY=

# ── Hub de Hira (licencias y actualizaciones) ───────────────────────────────
HUB_API_URL=
HUB_API_KEY=

# ── Observabilidad ──────────────────────────────────────────────────────────
CRASH_REPORTER_ENABLED=false
ENVIRONMENT=development
LOG_LEVEL=INFO
